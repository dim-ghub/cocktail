def get_mocktail_binary():
    custom = os.environ.get("MOCKTAIL_BIN")
    if custom and Path(custom).is_file() and os.access(custom, os.X_OK):
        return str(custom)
    if Path(DEFAULT_MOCKTAIL_BIN).is_file() and os.access(DEFAULT_MOCKTAIL_BIN, os.X_OK):
        return DEFAULT_MOCKTAIL_BIN
    if FALLBACK_MOCKTAIL_BIN.is_file() and os.access(FALLBACK_MOCKTAIL_BIN, os.X_OK):
        return str(FALLBACK_MOCKTAIL_BIN)
    bin_on_path = shutil.which("mocktail")
    if bin_on_path:
        return bin_on_path
    die("Nightcap binary ('mocktail') not found in /usr/bin, ~/Projects/nightcap/build, or $PATH.")


